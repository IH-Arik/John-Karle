APP_NAME="John Karl AI"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*

# Optional shared secret for protected AI endpoints.
INTERNAL_API_KEY=

# Provider: "mock" for local development, or "anthropic" for Claude.
AI_PROVIDER=mock
# Leave blank for the provider default: mock-v1 or claude-sonnet-4-6.
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=20000
AI_DEFAULT_MAX_TOKENS=512
AI_MAX_OUTPUT_TOKENS=2048
AI_PROMPT_INJECTION_GUARD=true

# Required only when AI_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
# SDK retries are disabled by default for predictable latency and cost.
ANTHROPIC_MAX_RETRIES=0

# Memory Chat (Phase 1): conversation history storage owned by this service.
# See PRODUCTION_READINESS.md "Phase 1 Decisions (Locked)" #3.
MEMORY_CHAT_DB_PATH=memory_chat.sqlite3
MEMORY_CHAT_WINDOW_TURNS=20
MEMORY_CHAT_SUMMARY_TRIGGER_TURNS=10

# Memory Quote (Phase 2): AI-generated pull-quote + commentary per memory,
# cached here and regenerated only when the backend asks. See
# PRODUCTION_READINESS.md "Phase 2 Decisions (Locked)".
MEMORY_QUOTE_DB_PATH=memory_quote.sqlite3

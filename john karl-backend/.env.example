# Runtime
NODE_ENV=development
PORT=5200
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/john_karle

# CORS: * for local use, comma-separated origins for deployment
CORS_ORIGIN=*

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Optional initial super-admin seed
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Gmail
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME="John Karle"
MAIL_REPLY_TO=
PASSWORD_RESET_CODE_EXPIRES_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15

# AWS S3
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Legacy access
LEGACY_ACCESS_INVITE_EXPIRES_HOURS=72
LEGACY_ACCESS_WAITING_DAYS=14
LEGACY_ACCESS_REQUEST_TTL_DAYS=44
LEGACY_ACCESS_JOB_INTERVAL_HOURS=24
LEGACY_ACCESS_ACTIVITY_TOUCH_INTERVAL_MINUTES=5
LEGACY_ACCESS_JOB_ENABLED=true
